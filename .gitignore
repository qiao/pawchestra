# Editor swap files and system files
.*.swp
.*.swo
.DS_Store

# Python bytecode of the Python scripts
__pycache__/

# Dependencies and build output
node_modules/
dist/

# Output of the Playwright tests (pnpm test:e2e)
test-results/
playwright-report/

# Output of tools/split-soundfont.ts. Vite serves it in dev and copies it into dist/.
public/sf/

# Output of tools/patch-demos.ts: the demo files after demos/patches.json (design 8.3).
public/demos/

# Output of tools/write-perf-60.ts: the file of the frame target (design 9.5). Only the dev
# server serves it.
perf/

# Probe scripts of an agent. A script here imports `three` and the source modules through the
# node_modules of its worktree: `node scratch/<name>.ts`.
scratch/

# The images of a round report. The manager reads them in the checkout of the agent. Git keeps no
# report image (design 9.8).
reports/

# The panda copy with the arms free of the trunk (tools/blender/panda_edit.py). Only
# tools/blender/arm_rebuild.py reads it, and a run writes the same bytes, so git keeps no copy of
# its 12 MB (assets/models/panda/README.md).
assets/models/panda/panda-edit.glb
